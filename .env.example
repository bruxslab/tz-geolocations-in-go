# Copy to .env. Generate separate URL-safe random secrets; never commit .env.
# Example generator for each password: openssl rand -hex 24
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_SECRET
TZ_OWNER_PASSWORD=REPLACE_WITH_RANDOM_OWNER_SECRET
TZ_RUNTIME_PASSWORD=REPLACE_WITH_RANDOM_READER_SECRET
POSTGRES_PORT=55432
HTTP_HOST=127.0.0.1
HTTP_PORT=8085
APP_ENV=development

# Host Go tooling reads exported variables, not .env automatically.
# Replace placeholders with the corresponding .env values for host commands.
DATABASE_URL=postgres://tz_reader:REPLACE_WITH_RANDOM_READER_SECRET@127.0.0.1:55432/tz_locations?sslmode=disable
MIGRATION_DATABASE_URL=postgres://tz_owner:REPLACE_WITH_RANDOM_OWNER_SECRET@127.0.0.1:55432/tz_locations?sslmode=disable
TEST_DATABASE_URL=postgres://tz_owner:REPLACE_WITH_RANDOM_OWNER_SECRET@127.0.0.1:55432/tz_locations_test?sslmode=disable
RUNTIME_DATABASE_ROLE=tz_reader
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=2
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
CORS_ORIGINS=*
TRUSTED_PROXIES=
